# Copy to .env (local) or load via systemd EnvironmentFile (EC2). NEVER commit .env.
# No AWS keys here: on EC2 boto3 uses the instance IAM role automatically.

# --- AWS ---
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-private-bucket-name
S3_PREFIX=documents/

# --- Admin auth (bcrypt hash only, generated by scripts/generate_admin_hash.py in Phase 2) ---
ADMIN_PASSWORD_HASH=
SESSION_TIMEOUT_MINUTES=30
MAX_FAILED_LOGINS=5
LOGIN_DELAY_SECONDS=2
LOGIN_LOCKOUT_MINUTES=5

# --- Development only: use an in-memory fake S3 (no AWS needed). Leave 0 on EC2. ---
DEV_FAKE_S3=0

# --- Uploads ---
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=100

# --- Local storage (runtime state, NOT original documents) ---
DATA_DIR=./runtime

# --- Models ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120

# --- Retrieval / chunking ---
SENTENCES_PER_CHUNK=3
SENTENCE_OVERLAP=1
BM25_TOP_K=5
FAISS_TOP_K=5
# Evidence thresholds are intentionally NOT set here. They are calibrated in Phase 7
# against the six seed docs + five example questions (+ extra tests), then saved.
