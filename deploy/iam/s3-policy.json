{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DocumentObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::solstice-docs-905418462063-aps1/documents/*"
    },
    {
      "Sid": "ReadDeployBundleOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::solstice-docs-905418462063-aps1/deploy/*"
    }
  ]
}
